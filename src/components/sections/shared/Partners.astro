---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface PartnerItem { logo: ImageMetadata; alt: string; url?: string; }
interface PartnerGroup { title: string; intro?: string; items: PartnerItem[]; }
interface Props {
  data: { groups: PartnerGroup[] };
}
const { data } = Astro.props;
---
<section class="partners" id="partners">
  <div class="partners__container _container">
    {data.groups.map((group, idx) => (
      <>
        {idx > 0 && (
          <section class="divider">
            <div class="divider__container _container">
              <div class="divider__line"></div>
            </div>
          </section>
        )}
        <div class="partners__item item-partners">
          <h3 class="item-partners__title title">{group.title}</h3>
          {group.intro && <div class="item-partners__intro">{group.intro}</div>}
          <div class="item-partners__logos">
            {group.items.map(item => (
              <div class="item-partners__image">
                <Image src={item.logo} alt={item.alt} width={240} loading="lazy" />
              </div>
            ))}
          </div>
        </div>
      </>
    ))}
  </div>
</section>
