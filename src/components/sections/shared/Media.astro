---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  data: { title: string; items: { url: string; logo: ImageMetadata; alt: string }[] };
}
const { data } = Astro.props;
---
<section class="aboutus">
  <div class="aboutus__container _container">
    <h3 class="aboutus__title title">{data.title}</h3>
    <div class="aboutus__content">
      {data.items.map(item => (
        <a href={item.url} class="aboutus__smi" target="_blank" rel="noopener">
          <Image src={item.logo} alt={item.alt} width={240} loading="lazy" />
        </a>
      ))}
    </div>
  </div>
</section>
