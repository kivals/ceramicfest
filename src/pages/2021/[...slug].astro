---
import Year2021Layout from '../../layouts/Year2021Layout.astro';

const bodies = import.meta.glob<string>('../../legacy/2021/*.body.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const pages = {
  index:   { pageTitle: 'Фестиваль керамики Млечный путь 2021' },
  photos:  { pageTitle: 'Фото и видео — Фестиваль керамики Млечный путь 2021' },
  team:    { pageTitle: 'Наша команда — Фестиваль керамики Млечный путь 2021' },
  reviews: { pageTitle: 'Отзывы — Фестиваль керамики Млечный путь 2021' },
} as const;

type PageKey = keyof typeof pages;

export async function getStaticPaths() {
  return [
    { params: { slug: undefined }, props: { key: 'index' } },
    { params: { slug: 'photos' },  props: { key: 'photos' } },
    { params: { slug: 'team' },    props: { key: 'team' } },
    { params: { slug: 'reviews' }, props: { key: 'reviews' } },
  ];
}

const { key } = Astro.props as { key: PageKey };
const body = bodies[`../../legacy/2021/${key}.body.html`];
const { pageTitle } = pages[key];
---
<Year2021Layout pageTitle={pageTitle}>
  <Fragment set:html={body} />
</Year2021Layout>
